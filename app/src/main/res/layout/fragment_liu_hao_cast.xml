<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="110dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lục Hào Nạp Giáp · chuyên sâu"
            android:textColor="@color/on_surface"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Luận Bát cung, Thế–Ứng, Nạp Giáp, Lục Thân, Lục Thần, Nhật–Nguyệt, Không Vong, hợp/xung và Dụng thần theo chủ đề."
            android:textColor="@color/on_surface_variant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Chủ đề cần xem"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerLiuHaoTopic"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@color/surface_variant"
            android:paddingHorizontal="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Câu hỏi cụ thể">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtLiuHaoQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/GoodDaily.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhật–Nguyệt dùng cho vượng suy"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGanzhiHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="App điền gần đúng theo ngày hiện tại; bạn có thể chỉnh theo lịch Can Chi chuyên dụng."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Nguyệt kiến" android:textColor="@color/on_surface_variant" />
                <Spinner
                    android:id="@+id/spinnerMonthBranch"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@color/surface_variant"
                    android:paddingHorizontal="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ngày can" android:textColor="@color/on_surface_variant" />
                        <Spinner
                            android:id="@+id/spinnerDayStem"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@color/surface_variant"
                            android:paddingHorizontal="10dp" />
                    </LinearLayout>

                    <Space android:layout_width="8dp" android:layout_height="1dp" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ngày chi" android:textColor="@color/on_surface_variant" />
                        <Spinner
                            android:id="@+id/spinnerDayBranch"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@color/surface_variant"
                            android:paddingHorizontal="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Sáu lần gieo từ hào 1 dưới cùng đến hào 6 trên cùng"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Hào 1">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtLine1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:inputType="number" android:maxLength="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="6dp" android:layout_height="1dp" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Hào 2">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtLine2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:inputType="number" android:maxLength="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="6dp" android:layout_height="1dp" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Hào 3">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtLine3" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:inputType="number" android:maxLength="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Hào 4">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtLine4" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:inputType="number" android:maxLength="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="6dp" android:layout_height="1dp" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Hào 5">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtLine5" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:inputType="number" android:maxLength="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space android:layout_width="6dp" android:layout_height="1dp" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Hào 6">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtLine6" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:inputType="number" android:maxLength="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCastCoins"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Gieo ba đồng xu 6 lần" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalculateLiuHao"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Lập quẻ và luận chuyên sâu" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLiuHaoResult"
            style="@style/GoodDaily.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView android:id="@+id/tvLiuHaoBase" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/on_surface" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvLiuHaoLines" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:lineSpacingExtra="4dp" android:textColor="@color/primary" android:textSize="21sp" android:typeface="monospace" />
                <TextView android:id="@+id/tvLiuHaoChanged" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/on_surface_variant" />
                <TextView android:id="@+id/tvLiuHaoInterpretation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@color/surface_variant" android:padding="14dp" android:textColor="@color/on_surface" />
                <TextView android:id="@+id/tvLiuHaoTechnical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:typeface="monospace" />
                <TextView android:id="@+id/tvLiuHaoTiming" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@color/surface_variant" android:padding="14dp" android:textColor="@color/on_surface" />
                <TextView android:id="@+id/tvLiuHaoConfidence" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/primary" android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveLiuHao"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:text="Lưu toàn bộ luận giải"
                    app:icon="@drawable/ic_check" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
